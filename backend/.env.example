PORT=5001
JWT_SECRET=change_this_secret

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://smartcity_app:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=smart_city

# Used only by npm run seed; choose your own admin credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_long_unique_password
ADMIN_NAME=City Admin

# --- CORS ---
# The deployed frontend's origin (e.g. https://smartcity.vercel.app).
# Leave blank locally to allow any origin.
FRONTEND_URL=
# Optional: if more than one frontend domain routes to this backend (e.g.
# an old project alias still pointing here after a rename, plus the current
# one), set a comma-separated list here instead of FRONTEND_URL above.
# FRONTEND_URLS=https://smartcity-frontend-virid.vercel.app,https://smartcity-complaint-portal.vercel.app

# Gmail SMTP example. Use a Gmail App Password, NOT your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_16_character_app_password

# Groq AI assistant (Citizen Desk chatbot)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Max distance (in meters) allowed between a citizen's reported location and
# the admin's "resolved" photo location for the resolution to be accepted.
RESOLUTION_DISTANCE_THRESHOLD_METERS=150
