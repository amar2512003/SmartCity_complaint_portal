PORT=5001
JWT_SECRET=change_this_secret

# --- Database ---
# Local dev: plain Postgres connection.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_city
#
# Supabase (production / Vercel): use the Transaction pooler connection
# string from Supabase > Connect > Transaction pooler (port 6543), with
# ?workaround=supabase-pooler.vercel appended when deploying on Vercel.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?workaround=supabase-pooler.vercel

# Optional: a separate connection used only for running `npm run migrate`.
# Use the Session pooler (port 5432) or Direct connection string here —
# migrations should not run through the transaction pooler. If omitted,
# DATABASE_URL above is reused for migrations too.
MIGRATION_DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- CORS ---
# The deployed frontend's origin (e.g. https://smartcity.vercel.app).
# Leave blank locally to allow any origin.
FRONTEND_URL=

# Gmail SMTP example. Use a Gmail App Password, NOT your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_16_character_app_password

# Groq AI assistant (Citizen Desk chatbot)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Max distance (in meters) allowed between a citizen's reported location and
# the admin's "resolved" photo location for the resolution to be accepted.
RESOLUTION_DISTANCE_THRESHOLD_METERS=150
