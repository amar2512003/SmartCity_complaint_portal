# Vite bakes this in at BUILD TIME, not runtime — .env here only affects
# local `npm run dev`. For the hosted/production build, set VITE_API_URL as
# an Environment Variable in the Vercel project settings (Production +
# Preview), pointing at the deployed backend, e.g.:
#   https://smartcity-backend.vercel.app/api
# If it's missing there, the production build silently falls back to
# whatever is in this file's local value below.
VITE_API_URL=http://localhost:5001/api

# Google Maps Platform key (Static Maps API enabled), used to render the
# location map preview shown after a photo is captured. Same build-time /
# Vercel env var rules as VITE_API_URL above apply. If unset, the app falls
# back to a plain lat/lng line instead of the map image.
VITE_GOOGLE_MAPS_API_KEY=
